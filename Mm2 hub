    text.BackgroundTransparency = 1
    text.Size = UDim2.new(1, 0, 1, 0)
    text.TextSize = 12
    text.Font = Enum.Font.GothamBold
    text.TextStrokeTransparency = 0
    text.Parent = bg
    return bg
end

local function UpdateESPState()
    local murdererPlayer = Modules.FindMurderer()
    local sheriffPlayer = Modules.FindSheriff()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local espColor = Color3.fromRGB(0, 255, 0)
            local espRole = "Innocent"

            if plr == murdererPlayer then espColor = Color3.fromRGB(255, 0, 0); espRole = "Murderer"
            elseif plr == sheriffPlayer then espColor = Color3.fromRGB(0, 0, 255); espRole = "Sheriff" end

            if Modules.Config.EspPlayers then
                local hl = char:FindFirstChild("VisionHighlight") or Instance.new("Highlight")
                hl.Name = "VisionHighlight"
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0
                hl.FillColor = espColor
                hl.OutlineColor = espColor
                hl.Parent = char
            else
                if char:FindFirstChild("VisionHighlight") then char.VisionHighlight:Destroy() end
            end

            if Modules.Config.ShowNames then
                local head = char:FindFirstChild("Head")
                if head then
                    local bg = head:FindFirstChild("NameESP") or CreateBillboard(head)
                    bg.Parent = head
                    local label = bg:FindFirstChild("TextLabel")
                                        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local enemyRoot = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
                    local dist = (root and enemyRoot) and math.floor((root.Position - enemyRoot.Position).Magnitude) or "Unknown"
                    if label then
                        label.Text = string.format("%s\n[%s] [%s]", plr.Name, espRole, tostring(dist))
                        label.TextColor3 = espColor
                    end
                end
            else
                if char:FindFirstChild("Head") and char.Head:FindFirstChild("NameESP") then char.Head.NameESP:Destroy() end
            end
        end
    end
end

