local function getPredictedPosition(player, offset)
    if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = player.Character.HumanoidRootPart
    local humanoid = player.Character:FindFirstChild("Humanoid")
    if humanoid then
        local velocity = hrp.AssemblyLinearVelocity
        local ping = LocalPlayer:GetNetworkPing() * getgenv().Settings.OffsetToPingMult
        return hrp.Position + (velocity * offset * ping)
    end
    return hrp.Position
end

local function executeShoot()
    local murderer = Modules.FindMurderer()
    if not murderer or not murderer.Character or not murderer.Character:FindFirstChild("HumanoidRootPart") then return end
    local gun = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Gun")
    if not gun or not gun:FindFirstChild("Shoot") then return end

    local murdererHRP = murderer.Character.HumanoidRootPart
    local predictedPos = getPredictedPosition(murderer, 1) or murdererHRP.Position
    local rightHand = LocalPlayer.Character:FindFirstChild("RightHand")
    local startPos = rightHand and rightHand.Position or LocalPlayer.Character.PrimaryPart.Position

    pcall(function()
        gun.Shoot:FireServer(CFrame.new(startPos), CFrame.new(predictedPos))
    end)
end

